# Runtime connection (pooled). Required.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-POOLER/us-east-1.aws.neon.tech/gatefold?sslmode=require"

# Direct connection used by migrations and seeds (Prisma CLI).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.us-east-1.aws.neon.tech/gatefold?sslmode=require"

# Integration tests. Never point these at the production database.
DATABASE_URL_TEST=""
DATABASE_URL_TEST_UNPOOLED=""

# Signs session-token hashes and reservation access references. 32 random bytes, hex.
SESSION_PEPPER=""

# Signs ticket QR payloads. 32 random bytes, hex.
TICKET_SIGNING_SECRET=""

# Public origin used for metadata and origin checks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Protects POST /api/internal/expire-holds.
CRON_SECRET=""

# The seed script refuses production database names unless this is set to 1.
ALLOW_PROD_SEED=""
