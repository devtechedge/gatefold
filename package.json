{
  "name": "gatefold",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node scripts/prepare-test-db.mjs && vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "node scripts/prepare-test-db.mjs && vitest run tests/integration",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx scripts/seed-demo.ts",
    "db:status": "prisma migrate status",
    "e2e": "npm run build && node scripts/prepare-e2e-db.mjs && playwright test",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "jsqr": "^1.4.0",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "7.10.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
